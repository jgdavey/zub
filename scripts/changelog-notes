#!/usr/bin/env bash
# Print the CHANGELOG.md section for a version (without its "## [x.y.z]" heading).
# Exits non-zero if the changelog has no section for that version.
#
# Usage: changelog-notes <version> [changelog]
set -euo pipefail

version="${1:?usage: changelog-notes <version> [changelog]}"
changelog="${2:-$(dirname "$0")/../CHANGELOG.md}"

# The section runs to the next heading or the link references at the bottom;
# sed drops leading blank lines.
notes="$(
  awk -v v="${version#v}" '
    /^## / { if (on) exit; on = index($0, "## [" v "]") == 1; next }
    /^\[[^]]+\]: / { if (on) exit }
    on
  ' "$changelog" | sed '/./,$!d'
)"

if [ -z "$notes" ]; then
  echo "changelog-notes: no section for ${version#v} in $changelog" >&2
  exit 1
fi
printf '%s\n' "$notes"
